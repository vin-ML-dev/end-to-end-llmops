# copy to k8s/.env and fill in real values — k8s/.env is gitignored
# the EXTERNAL cloud model endpoint (OpenAI-compatible /v1), e.g.:
#   https://<pod-id>-8000.proxy.runpod.net/v1
#   https://api.together.xyz/v1
DOMAINBOT_ENGINE_URL=https://REPLACE-ME.example.com/v1
# auth token for the external endpoint (leave empty if none)
DOMAINBOT_ENGINE_API_KEY=
# the gateway's OWN api key (clients use this to call the gateway)
DOMAINBOT_API_KEY=
